{
  "expo": {
    "name": "emagrecer neh carai",
    "slug": "emagrecernehcarai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emagrecernehcarai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emagrecernehcarai.app"
    },
    "android": {
      "package": "com.emagrecernehcarai.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "emagrecer neh carai",
      "shortName": "Emagrecer",
      "lang": "pt-BR",
      "backgroundColor": "#000000",
      "themeColor": "#f472b6",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "description": "Acompanhe calorias, água e treinos. Bora emagrecer, monstro!"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}